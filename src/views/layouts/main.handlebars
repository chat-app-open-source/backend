<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light dark">
    <meta name="supported-color-schemes" content="light dark">
    <title>{{title}}</title>
    <style>
        {{{css}}}
        * {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family:
    -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans',
    'Helvetica Neue', sans-serif;
  background-color: #f8fafc;
  color: #334155;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

.email-container {
  max-width: 600px;
  margin: 0 auto;
  background-color: #ffffff;
  border-radius: 16px;
  box-shadow:
    0 10px 25px -5px rgba(0, 0, 0, 0.1),
    0 8px 10px -6px rgba(0, 0, 0, 0.1);
  overflow: hidden;
}

.header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  padding: 2.5rem 2rem;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.header::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
  transform: rotate(30deg);
}

.header h1 {
  margin: 0;
  font-size: 1.875rem;
  font-weight: 700;
  position: relative;
  z-index: 1;
}

.header p {
  margin: 0.5rem 0 0;
  opacity: 0.9;
  font-size: 1rem;
  position: relative;
  z-index: 1;
}

.content {
  padding: 2.5rem 2rem;
}

.greeting {
  font-size: 1.25rem;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 1rem;
}

.message {
  color: #64748b;
  margin-bottom: 2rem;
  line-height: 1.7;
}

.otp-section {
  text-align: center;
  margin: 2.5rem 0;
}

.otp-label {
  display: block;
  font-size: 0.875rem;
  color: #64748b;
  margin-bottom: 0.75rem;
  font-weight: 500;
}

.otp-code {
  display: inline-block;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  padding: 1.25rem 2.5rem;
  border-radius: 12px;
  font-size: 2.25rem;
  font-weight: 700;
  font-family: 'SF Mono', 'Monaco', 'Inconsolata', 'Roboto Mono', monospace;
  letter-spacing: 0.25em;
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  margin: 0.5rem 0;
  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.otp-code:hover {
  transform: translateY(-2px);
  box-shadow:
    0 20px 25px -5px rgba(0, 0, 0, 0.1),
    0 10px 10px -5px rgba(0, 0, 0, 0.04);
}

.otp-expiry {
  font-size: 0.875rem;
  color: #94a3b8;
  margin-top: 1rem;
}

.cta-button {
  display: inline-block;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  text-decoration: none;
  padding: 1rem 2rem;
  border-radius: 8px;
  font-weight: 600;
  margin: 1.5rem 0;
  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.cta-button:hover {
  transform: translateY(-1px);
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.2);
}

.divider {
  height: 1px;
  background: linear-gradient(90deg, transparent 0%, #e2e8f0 50%, transparent 100%);
  margin: 2rem 0;
}

.security-note {
  background-color: #f1f5f9;
  padding: 1.25rem;
  border-radius: 8px;
  border-left: 4px solid #667eea;
  margin: 2rem 0;
}

.security-note h3 {
  color: #1e293b;
  font-size: 1rem;
  margin-bottom: 0.5rem;
  font-weight: 600;
}

.security-note p {
  color: #64748b;
  font-size: 0.875rem;
  margin: 0;
  line-height: 1.6;
}

.footer {
  padding: 2rem;
  background-color: #f8fafc;
  text-align: center;
  border-top: 1px solid #e2e8f0;
}

.footer-content {
  max-width: 400px;
  margin: 0 auto;
}

.footer p {
  margin: 0.5rem 0;
  color: #94a3b8;
  font-size: 0.875rem;
}

.social-links {
  margin: 1.5rem 0;
}

.social-link {
  display: inline-block;
  margin: 0 0.75rem;
  color: #667eea;
  text-decoration: none;
  font-weight: 500;
  transition: color 0.2s ease;
}

.social-link:hover {
  color: #764ba2;
}

.copyright {
  margin-top: 1.5rem;
  padding-top: 1.5rem;
  border-top: 1px solid #e2e8f0;
  font-size: 0.75rem;
}

/* Responsive Design */
@media (max-width: 640px) {
  .email-container {
    margin: 0;
    border-radius: 0;
    box-shadow: none;
  }

  .header {
    padding: 2rem 1.5rem;
  }

  .header h1 {
    font-size: 1.5rem;
  }

  .content {
    padding: 2rem 1.5rem;
  }

  .otp-code {
    font-size: 1.875rem;
    padding: 1rem 2rem;
  }

  .cta-button {
    width: 100%;
    text-align: center;
  }
}

/* Dark mode support */
@media (prefers-color-scheme: dark) {
  body {
    background-color: #0f172a;
    color: #cbd5e1;
  }

  .email-container {
    background-color: #1e293b;
  }

  .message {
    color: #94a3b8;
  }

  .greeting {
    color: #f1f5f9;
  }

  .security-note {
    background-color: #334155;
    border-left-color: #818cf8;
  }

  .security-note h3 {
    color: #f1f5f9;
  }

  .footer {
    background-color: #0f172a;
    border-top-color: #334155;
  }

  .copyright {
    border-top-color: #334155;
  }
}

/* Animation for better UX */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.content > * {
  animation: fadeIn 0.6s ease forwards;
}

.otp-section {
  animation: fadeIn 0.8s ease forwards;
}

.footer {
  animation: fadeIn 1s ease forwards;
}

    </style>
</head>
<body>
    <div class="email-container">
        {{> header}}
        <div class="content">
            {{{body}}}
        </div>
        {{> footer}}
    </div>
</body>
</html>